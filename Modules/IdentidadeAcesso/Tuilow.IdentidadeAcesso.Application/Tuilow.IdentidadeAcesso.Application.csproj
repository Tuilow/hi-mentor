<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tuilow.IdentidadeAcesso.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tuilow.IdentidadeAcesso.Domain\Tuilow.IdentidadeAcesso.Domain.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\Tuilow.SharedKernel.Application\Tuilow.SharedKernel.Application.csproj" />
    <!-- Acoplamento legítimo: o painel do dono da plataforma (GetPlatformStatsQuery) precisa
         contar cursos publicados e vídeos, e a exclusão de conta em cascata (DeleteUserCommand)
         precisa enumerar e apagar os cursos/vídeos do criador excluído — mesma relação de negócio
         já usada por Streaming.Application ao referenciar Catalog.Domain no DeleteVideoCommandHandler. -->
    <ProjectReference Include="..\..\Catalog\Tuilow.Catalog.Domain\Tuilow.Catalog.Domain.csproj" />
    <ProjectReference Include="..\..\Streaming\Tuilow.Streaming.Domain\Tuilow.Streaming.Domain.csproj" />
    <ProjectReference Include="..\..\Streaming\Tuilow.Streaming.Application\Tuilow.Streaming.Application.csproj" />
  </ItemGroup>
</Project>

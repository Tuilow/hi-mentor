<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HiMentor.CreatorStudio.Application</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HiMentor.CreatorStudio.Domain\HiMentor.CreatorStudio.Domain.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\HiMentor.SharedKernel.Application\HiMentor.SharedKernel.Application.csproj" />
    <!--
      CreatorStudio é, por natureza, um contexto de ORQUESTRAÇÃO/COMPOSIÇÃO: a tela "Meus
      Produtos" e o dashboard do produto agregam dados de Catalog (dados do produto),
      Sales (vendas/assinaturas), Learning (alunos matriculados) e Finance (comissão vigente)
      sem duplicar nenhuma dessas regras — só lê pelos repositórios já existentes de cada módulo
      (mesmo padrão de acoplamento legítimo documentado em Finance/Payout).
    -->
    <ProjectReference Include="..\..\Catalog\HiMentor.Catalog.Domain\HiMentor.Catalog.Domain.csproj" />
    <ProjectReference Include="..\..\Sales\HiMentor.Sales.Domain\HiMentor.Sales.Domain.csproj" />
    <ProjectReference Include="..\..\Learning\HiMentor.Learning.Domain\HiMentor.Learning.Domain.csproj" />
    <ProjectReference Include="..\..\Finance\HiMentor.Finance.Domain\HiMentor.Finance.Domain.csproj" />
  </ItemGroup>
</Project>

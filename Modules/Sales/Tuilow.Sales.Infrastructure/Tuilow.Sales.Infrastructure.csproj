<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tuilow.Sales.Infrastructure</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.4" />
    <!-- B4: configuration.GetValue<T>() usado pelo job de expiração para ler os prazos de configuração. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <!-- M2: retry com backoff + circuit breaker + timeout para o HttpClient da Asaas. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.4.0" />
    <!-- B4: BackgroundService do job de expiração (PastDue -> Expired / Pending antigo). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tuilow.Sales.Application\Tuilow.Sales.Application.csproj" />
    <!-- Acoplamento legítimo: IUserProvisioningService consulta/cria contas no módulo
         IdentidadeAcesso para o checkout anônimo (compra sem login prévio). -->
    <ProjectReference Include="..\..\IdentidadeAcesso\Tuilow.IdentidadeAcesso.Domain\Tuilow.IdentidadeAcesso.Domain.csproj" />
    <!-- Acoplamento legítimo (achado A5 da avaliação): FinanceWalletCreditChecker consulta o
         módulo Finance para o job de reconciliação (venda Confirmed sem WalletTransaction
         correspondente) — mesma direção de acoplamento já usada acima para IdentidadeAcesso. -->
    <ProjectReference Include="..\..\Finance\Tuilow.Finance.Domain\Tuilow.Finance.Domain.csproj" />
  </ItemGroup>
</Project>

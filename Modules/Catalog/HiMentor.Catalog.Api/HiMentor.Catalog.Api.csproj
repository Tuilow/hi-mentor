<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HiMentor.Catalog.Api</RootNamespace>
    <!--
      Sdk normal (não Sdk.Web) de propósito: este projeto só expõe Controllers para o
      Host montar via AddApplicationPart — não é um executável próprio, não tem Program.cs.
      Ver mesmo padrão em HiMentor.IdentidadeAcesso.Api.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HiMentor.Catalog.Application\HiMentor.Catalog.Application.csproj" />
    <ProjectReference Include="..\HiMentor.Catalog.Infrastructure\HiMentor.Catalog.Infrastructure.csproj" />
  </ItemGroup>
</Project>

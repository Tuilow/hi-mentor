<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tuilow.Learning.Infrastructure</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.4" />
    <!-- Feature 12/08/2026 ("Baixar certificado"): geração de PDF do certificado sob demanda —
         ver QuestPdfCertificateGenerator (Services). Licença Community (gratuita), ver comentário
         no topo daquele arquivo. Se o restore falhar por esta versão ter saído do índice do
         NuGet, é seguro trocar para a versão estável mais recente da série 2024.x/2025.x. -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tuilow.Learning.Application\Tuilow.Learning.Application.csproj" />
    <!-- Acoplamento legítimo: verificação de acesso pago consulta o módulo Sales (assinaturas). -->
    <ProjectReference Include="..\..\Sales\Tuilow.Sales.Domain\Tuilow.Sales.Domain.csproj" />
    <!-- Acoplamento legítimo: IUserContactLookup consulta o módulo IdentidadeAcesso (e-mail/nome
         do usuário) para o e-mail automático de acesso liberado. -->
    <ProjectReference Include="..\..\IdentidadeAcesso\Tuilow.IdentidadeAcesso.Domain\Tuilow.IdentidadeAcesso.Domain.csproj" />
  </ItemGroup>
</Project>
